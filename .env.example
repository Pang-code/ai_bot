MODEL_API_KEY=
MODEL_BASE_URL=https://api.example.com/v1
MODEL_NAME=your-model
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2

# 必须替换为至少 32 字符的加密随机值，例如：openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
JWT_ISSUER=ai-agents-api
JWT_AUDIENCE=ai-agents-frontend

DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/postgres
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT_SECONDS=30

API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 视觉模型(图片描述用)：填你自己的 VLM 渠道地址与密钥，写入 .env
VLM_API_KEY=
VLM_BASE_URL=https://api.example.com/v1
VLM_MODEL=your-vision-model


# RAG 知识库检索 (Milvus + Ollama bge-m3)
# RAG_EMBED_URL 填你的 Ollama 服务地址（本机 127.0.0.1 / 局域网机器的实际 IP），写入 .env
RAG_MILVUS_URI=http://localhost:19530
RAG_COLLECTION=rag_chunks
RAG_EMBED_URL=http://127.0.0.1:11434
RAG_EMBED_MODEL=bge-m3
RAG_TOP_K=5
RAG_RECALL=15
RAG_PER_SOURCE_CAP=2
RAG_SCORE_THRESHOLD=0.45
